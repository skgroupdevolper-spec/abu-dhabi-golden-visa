# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://www.abudhabigoldenvisa.com"

# Customer dashboard host. Requests to this host are served the client portal.
PORTAL_HOST="app.abudhabigoldenvisa.com"

# Folder for enquiries, applications, settings and uploaded documents.
# On the server keep it outside the code folder: "~/adgv-data" is in the site user's home and survives redeploys.
DATA_DIR="~/adgv-data"

# Team dashboard sign-in (www.abudhabigoldenvisa.com/admin/). Set a long password (12+ characters);
# short or sample passwords are ignored for safety.
ADMIN_EMAIL="info@brightlinkconsulting.ae"
ADMIN_PASSWORD=""
# More users: ADMIN_USERS="name@example.com:password,other@example.com:password"
# Long random text that signs admin sessions (keep secret). Leave empty: the site makes one itself.
SESSION_SECRET=""

# Port used by "npm start" (xCloud / PM2)
PORT=3000

# Link used by the "Client login" buttons on the website
NEXT_PUBLIC_PORTAL_URL="https://app.abudhabigoldenvisa.com/login/"

# Key for the daily scheduled job. Leave empty: the site makes one; run it with `npm run cron`.
CRON_SECRET=""
