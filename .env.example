# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://www.abudhabigoldenvisa.com"

# Customer dashboard host. Requests to this host are served the client portal.
PORTAL_HOST="app.abudhabigoldenvisa.com"

# Folder for enquiries, applications, settings and uploaded documents.
# On the server, use a folder outside the release, e.g. /home/<user>/adgv-data
DATA_DIR="./data"

# Team dashboard sign-in (www.abudhabigoldenvisa.com/admin/)
ADMIN_EMAIL="info@brightlinkconsulting.ae"
ADMIN_PASSWORD="change-this-to-a-long-password"
# More users: ADMIN_USERS="name@example.com:password,other@example.com:password"
# Long random text that signs admin sessions (keep secret)
SESSION_SECRET="replace-with-a-long-random-string"

# Port used by "npm start" (xCloud / PM2)
PORT=3000
